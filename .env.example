# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for signing and verifying authentication tokens
JWT_SECRET="MY_JWT_SECRET"

# DATABASE_URL: Supabase PostgreSQL connection URL (required for shared data; without it the
# app runs in memory only and loses everything on restart). Set it in Vercel's environment too.
# Supabase Transaction Pooler (Recommended for Vercel Serverless in region ap-southeast-1):
DATABASE_URL="postgresql://postgres.qbjoclyhqctgrvlrqvgf:[PWD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# AZURE DEPLOYMENT CONFIGURATION
# Tenant: drpradeepsinghmyintellx.onmicrosoft.com
# Subscription: 9705dfa8-59ea-40ec-b5ab-f2b89e0c5d43
AZURE_TENANT_ID="drpradeepsinghmyintellx.onmicrosoft.com"
AZURE_SUBSCRIPTION_ID="9705dfa8-59ea-40ec-b5ab-f2b89e0c5d43"
AZURE_RESOURCE_GROUP="rg-mfe-formwork-prod"
AZURE_WEBAPP_NAME="mfe-formwork-mr11-app"

# USD_TO_MYR_RATE: optional fallback USD to ringgit rate. MR11 uses the live rate from public
# exchange-rate services; this is only used if they cannot be reached and no rate was fetched yet.
USD_TO_MYR_RATE=""
