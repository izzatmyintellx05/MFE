{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.1.0.0",
  "metadata": {
    "description": "MFE Formwork MR11 on Azure App Service (Linux, Node 22). Azure pulls the GitHub repository, runs npm install and npm run build, then starts the app with npm start."
  },
  "parameters": {
    "webAppName": {
      "type": "string",
      "defaultValue": "[concat('mfe-mr11-', uniqueString(resourceGroup().id))]",
      "minLength": 2,
      "maxLength": 60,
      "metadata": {
        "description": "Web app name; it becomes <name>.azurewebsites.net and must be unique across Azure."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the app (defaults to the resource group's region)."
      }
    },
    "sku": {
      "type": "string",
      "defaultValue": "B1",
      "allowedValues": ["B1", "B2", "B3", "S1", "P0v3", "P1v3"],
      "metadata": {
        "description": "App Service plan size. B1 is the smallest plan that can stay always on."
      }
    },
    "databaseUrl": {
      "type": "securestring",
      "metadata": {
        "description": "Supabase connection string (Transaction pooler URI, port 6543, with your database password)."
      }
    },
    "jwtSecret": {
      "type": "securestring",
      "defaultValue": "[newGuid()]",
      "metadata": {
        "description": "Secret used to sign logins. Leave the generated value unless you need a specific one."
      }
    },
    "repoUrl": {
      "type": "string",
      "defaultValue": "https://github.com/orapradeep/MFE",
      "metadata": {
        "description": "Public GitHub repository to deploy."
      }
    },
    "branch": {
      "type": "string",
      "defaultValue": "main",
      "metadata": {
        "description": "Branch to deploy."
      }
    }
  },
  "variables": {
    "planName": "[concat(parameters('webAppName'), '-plan')]"
  },
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-09-01",
      "name": "[variables('planName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('sku')]"
      },
      "kind": "linux",
      "properties": {
        "reserved": true
      }
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-09-01",
      "name": "[parameters('webAppName')]",
      "location": "[parameters('location')]",
      "kind": "app,linux",
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]"
      ],
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('planName'))]",
        "httpsOnly": true,
        "siteConfig": {
          "linuxFxVersion": "NODE|22-lts",
          "appCommandLine": "npm start",
          "alwaysOn": true,
          "healthCheckPath": "/health",
          "ftpsState": "Disabled",
          "minTlsVersion": "1.2",
          "appSettings": [
            {
              "name": "DATABASE_URL",
              "value": "[parameters('databaseUrl')]"
            },
            {
              "name": "JWT_SECRET",
              "value": "[parameters('jwtSecret')]"
            },
            {
              "name": "NODE_ENV",
              "value": "production"
            },
            {
              "name": "NPM_CONFIG_INCLUDE",
              "value": "dev"
            },
            {
              "name": "SCM_DO_BUILD_DURING_DEPLOYMENT",
              "value": "true"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Web/sites/sourcecontrols",
      "apiVersion": "2022-09-01",
      "name": "[concat(parameters('webAppName'), '/web')]",
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('webAppName'))]"
      ],
      "properties": {
        "repoUrl": "[parameters('repoUrl')]",
        "branch": "[parameters('branch')]",
        "isManualIntegration": true
      }
    }
  ],
  "outputs": {
    "webAppUrl": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.Web/sites', parameters('webAppName'))).defaultHostName)]"
    },
    "healthCheckUrl": {
      "type": "string",
      "value": "[concat('https://', reference(resourceId('Microsoft.Web/sites', parameters('webAppName'))).defaultHostName, '/api/health/db')]"
    }
  }
}
